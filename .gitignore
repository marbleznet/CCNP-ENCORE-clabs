# =============================================================================
#  Containerlab runtime artifacts
# =============================================================================
# Everything below is GENERATED by `containerlab deploy` — it is per-deployment
# state, not source. The lab *source* (the *.clab.yml topology, its
# *.clab.yml.annotations.json diagram, and configs/*.cfg) is tracked; the runtime
# directory it spins up is not.

# Per-lab runtime directory: node NVRAM, boot configs, TLS keys/CA, NETMAP,
# generated inventories, topology-data.json, .state.clab.yaml, authorized_keys.
clab-*/

# Backup topology file containerlab writes on redeploy.
*.clab.yml.bak

# =============================================================================
#  OS / editor noise
# =============================================================================
.DS_Store
*.swp

# labctl runtime state (which fault is currently injected)
.faultstate.json
